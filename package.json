{
  "name": "open-notebook-nimi",
  "version": "1.14.7",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "packageManager": "pnpm@10.34.7",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "protobufjs"
    ]
  },
  "scripts": {
    "dev": "nimi-app dev --shell electron",
    "dev:renderer": "corepack pnpm --dir frontend dev --hostname 127.0.0.1 --port 6012",
    "init": "nimi-app init --adopt",
    "sync": "nimi-app sync",
    "check": "nimi-app check",
    "test:app": "pnpm test:electron && node scripts/nimi-uv.mjs run --managed-python --python 3.12 --locked pytest tests/ && pnpm --dir frontend test",
    "test:electron": "pnpm build:electron && node --test tests/electron/*.test.mjs",
    "test": "nimi-app test",
    "build": "pnpm --dir frontend build",
    "build:electron": "tsc -p tsconfig.electron.json && node scripts/bundle-electron-preload.mjs",
    "build:electron:production": "node scripts/package-electron-production.mjs",
    "postinstall": "install-electron --no",
    "app:build": "nimi-app build",
    "pack": "nimi-app pack",
    "dev:shell": "nimi-app dev",
    "dev:electron": "nimi-app dev --shell electron",
    "setup:backend": "node scripts/setup-backend.mjs",
    "build:backend": "pnpm run setup:backend && node scripts/nimi-uv.mjs run --managed-python --python 3.12 --locked python scripts/build-notebook-worker.py",
    "dev:web": "nimi-app dev --platform web",
    "dev:web-renderer": "node scripts/dev-web.mjs",
    "build:web": "node scripts/build-web.mjs",
    "build:mobile": "vite build --config vite.mobile.config.ts",
    "sync:android": "pnpm run build:mobile && cap sync android",
    "dev:android": "pnpm run sync:android && cap run android --no-sync",
    "dev:mobile": "nimi-app dev --platform mobile --realm local"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@nimiplatform/kit": "^0.24.0-rc.1",
    "@nimiplatform/sdk": "^0.24.0-rc.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@electron/packager": "^20.3.0",
    "@nimiplatform/app-tools": "^0.16.0-rc.2",
    "@nimiplatform/nimi-coding": "0.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.0.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.3",
    "yaml": "^2.9.0"
  },
  "author": "Luis Novo and Open Notebook contributors; Nimi adaptation contributors"
}
