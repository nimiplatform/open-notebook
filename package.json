{
  "name": "open-notebook-nimi",
  "version": "1.14.6",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "protobufjs"
    ]
  },
  "scripts": {
    "dev": "nimi-app dev --shell electron",
    "dev:renderer": "corepack pnpm --dir frontend dev --hostname 127.0.0.1 --port 6012",
    "init": "nimi-app init --adopt",
    "sync": "nimi-app sync",
    "check": "nimi-app check",
    "test:app": "node scripts/nimi-uv.mjs run --managed-python --python 3.12 --locked pytest tests/ && pnpm --dir frontend test",
    "test": "nimi-app test",
    "build": "pnpm --dir frontend build",
    "build:electron": "tsc -p tsconfig.electron.json && node scripts/bundle-electron-preload.mjs",
    "build:electron:production": "node scripts/package-electron-production.mjs",
    "postinstall": "install-electron --no",
    "app:build": "nimi-app build",
    "pack": "nimi-app pack",
    "dev:shell": "nimi-app dev",
    "dev:electron": "nimi-app dev --shell electron",
    "setup:backend": "node scripts/setup-backend.mjs",
    "build:backend": "pnpm run setup:backend && node scripts/nimi-uv.mjs run --managed-python --python 3.12 --locked python scripts/build-notebook-worker.py"
  },
  "dependencies": {
    "@nimiplatform/kit": "^0.19.0",
    "@nimiplatform/sdk": "^0.21.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@nimiplatform/app-tools": "^0.12.2",
    "@nimiplatform/nimi-coding": "0.6.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.3",
    "yaml": "^2.9.0"
  },
  "author": "Luis Novo and Open Notebook contributors; Nimi adaptation contributors"
}
